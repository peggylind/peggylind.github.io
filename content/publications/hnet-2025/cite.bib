@article{hnet_2025,
 abstractnote = {&amp;lt;p class=&amp;quot;p1&amp;quot;&amp;gt;&amp;lt;span class=&amp;quot;s1&amp;quot;&amp;gt;&amp;lt;em&amp;gt;Sharing Stories from 1977: Putting the National Women’s Conference on the Map &amp;lt;/em&amp;gt;(&amp;lt;/span&amp;gt;&amp;lt;span class=&amp;quot;s2&amp;quot;&amp;gt;https://sharingstories1977.uh.edu/&amp;lt;/span&amp;gt;&amp;lt;span class=&amp;quot;s1&amp;quot;&amp;gt;) is a robust, multiyear National Endowment for the Humanities–supported digital humanities project. It showcases student researchers’ work documenting and interpreting the federally funded 1977 National Women’s Conference (NWC) held in Houston, Texas. This project originated in 2017 when activist Gloria Steinem urged historians and archivists at the University of Houston (UH) to collect the stories and ephemera of NWC participants. This essay is based on a roundtable that brought together project content and technology leads to discuss why and how we developed this public-facing educational site and its connected programming and resources. The roundtable included educators nationwide who have taught the project and witnessed a lasting impact on over one thousand students nationally and over two thousand at UH. These students have written NWC participant biographies, conducted oral histories, and drafted interpretive essays as named contributors. Educators can use the site to augment classroom conversations and student understanding of women’s local, state, and national civic engagement. Introducing the concept of “big biography,” we encourage students to consider NWC participants of different regions and backgrounds comparatively. This panel introduces how to begin and sustain a digital humanities project and highlights its importance as a lifeblood of the humanities.&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;},
 author = {Davidson, Sandra and Lindner, Peggy and Rodwell, Elizabeth and Wagman, Jamie and Westkaemper, Emily and Wu, Judy Tzu-Chun and Young, Nancy Beck and Zarnow, Leandra},
 doi = {10.33823/phtc.v3i1.325},
 journal = {Proceedings of the H-Net Teaching Conference},
 month = {Jul.},
 number = {1},
 pages = {86–101},
 title = {Using Public Digital Humanities to Excite Students},
 url = {https://journals.h-net.org/phtc/article/view/proceedings_v3_using_public_dh},
 volume = {3},
 year = {2025}
}
